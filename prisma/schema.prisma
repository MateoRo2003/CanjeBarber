// Prisma schema — Sistema de Puntos y Fidelización (Barbería)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id             String        @id @default(cuid())
  nombre         String
  // Login con Google (uno de los dos métodos de login, el otro es
  // teléfono+contraseña más abajo — un Cliente tiene uno de los dos,
  // o eventualmente ambos si más adelante se suma "vincular cuenta").
  email          String?       @unique
  googleId       String?       @unique
  // Login alternativo con teléfono+contraseña (sin verificación por SMS:
  // es solo un identificador + contraseña propios de la app, no prueba
  // que el teléfono sea realmente de esa persona).
  telefono       String?       @unique
  passwordHash   String?
  puntosActuales Int           @default(0)
  // Deshabilitado por el admin: no puede iniciar sesión ni usar la app,
  // pero conserva todo su historial (a diferencia de eliminarlo).
  activo         Boolean       @default(true)
  fechaRegistro  DateTime      @default(now())
  // Último login exitoso (Google o teléfono), sea alta nueva o vuelta de
  // un cliente ya existente. Lo usa el descuento por inactividad (ver
  // Configuracion) cuando "login" es una de las condiciones marcadas.
  ultimoLogin    DateTime?
  transacciones  Transaccion[]

  @@map("clientes")
}

model Servicio {
  id               String   @id @default(cuid())
  nombre           String
  puntosOtorgados  Int
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())

  @@map("servicios")
}

model Premio {
  id          String   @id @default(cuid())
  nombre      String
  puntosCosto Int
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  @@map("premios")
}

enum TipoTransaccion {
  SUMA
  CANJE
  // Ajuste manual de puntos hecho por el admin (corrección, cortesía,
  // etc.), positivo o negativo, sin pasar por servicio ni premio.
  AJUSTE
  // Bono automático por primer login / registro (ver modelo
  // Configuracion). Se otorga una sola vez, al crear el Cliente.
  BONUS
  // Descuento automático por inactividad (ver Configuracion). Progresivo:
  // se repite cada vez que pasa otro período completo sin actividad.
  PENALIZACION
}

model Transaccion {
  id            String          @id @default(cuid())
  // onDelete: Cascade porque eliminar un cliente (a diferencia de
  // deshabilitarlo) borra también todo su historial de transacciones.
  cliente       Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId     String
  tipo          TipoTransaccion
  // id del Servicio si tipo=SUMA, id del Premio si tipo=CANJE,
  // "manual" si tipo=AJUSTE, "bienvenida" si tipo=BONUS,
  // "inactividad" si tipo=PENALIZACION.
  referenciaId  String
  puntos        Int
  // Motivo del ajuste manual (solo aplica si tipo=AJUSTE); para
  // PENALIZACION guarda cuántos días de inactividad la dispararon.
  nota          String?
  fecha         DateTime        @default(now())

  @@index([clienteId])
  @@map("transacciones")
}

// Configuración global de la app (fila única, id fijo "config"). Cada
// funcionalidad configurable suma sus propios campos acá en vez de tener
// una tabla por cada una.
model Configuracion {
  id                String   @id @default("config")
  // Si está activo, todo Cliente NUEVO (primer login con Google o primer
  // registro por teléfono) recibe puntosBienvenida automáticamente. No
  // se vuelve a otorgar en logins siguientes.
  bienvenidaActiva  Boolean  @default(false)
  puntosBienvenida  Int      @default(0)

  // Descuento progresivo de puntos por inactividad (ver
  // src/lib/inactividad.ts). Un Cliente está "inactivo" cuando pasaron
  // inactividadDias sin ninguna de las señales marcadas como actividad
  // acá abajo — y mientras siga así, se le vuelve a descontar cada vez
  // que pasa otro período igual (por eso "progresivo").
  inactividadActiva          Boolean @default(false)
  inactividadDias            Int     @default(30)
  inactividadPuntos          Int     @default(0)
  // Qué cuenta como "seguir activo". Al menos una tiene que estar
  // marcada para poder activar inactividadActiva.
  inactividadConsideraLogin  Boolean @default(true)
  inactividadConsideraCanje  Boolean @default(true)
  inactividadConsideraSuma   Boolean @default(true)

  actualizadoEn     DateTime @updatedAt

  @@map("configuracion")
}
